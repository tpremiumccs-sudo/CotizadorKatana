# ═══════════════════════════════════════════════════════════════════════════
#  Cotizador Katana Talent — variables de entorno
#
#  Copia este archivo a `.env` y cambia TODOS los valores marcados con CAMBIAR.
#  Genera los secretos con:  openssl rand -base64 48
#
#  TODOS los valores van entrecomillados: `docker compose` y `set -a; . .env`
#  interpretan de forma distinta los caracteres # $ y los espacios.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Base de datos ───────────────────────────
POSTGRES_USER="katana"
POSTGRES_PASSWORD="CAMBIAR_password_de_postgres"
POSTGRES_DB="katana"

# Dentro de Docker el host es el nombre del servicio (`db`).
# Para correr la app fuera de Docker contra la base de Docker usa localhost:5433.
DATABASE_URL="postgresql://katana:CAMBIAR_password_de_postgres@db:5432/katana?schema=public&connection_limit=10"

# ──────────────────────────── Aplicación ────────────────────────────
# NODE_ENV lo fija Next y Docker. NO lo pongas aquí: rompe `next build`.
#
# APP_PUBLIC_URL es el dominio real y NO es cosmético: se hornea en el build de
# la imagen (`allowedOrigins` de las Server Actions). Si lo cambias después,
# hay que reconstruir con `./deploy.sh actualizar`; ninguna variable de entorno
# lo arregla en caliente.
APP_PUBLIC_URL="https://cotizador.katanatalent.com"
PORT="3000"

# Nombre de la imagen. Mientras se compile en el propio servidor esto es sólo
# una etiqueta local y no hay que tocarlo. El día que la imagen se publique en
# GHCR, se descomenta y el servidor deja de compilar 20 minutos por despliegue:
#   APP_IMAGE="ghcr.io/tpremiumccs-sudo/cotizadorkatana"
#   APP_VERSION="latest"

# Aquí NO va ningún secreto de sesión. Las sesiones son opacas: el identificador
# es aleatorio y la fila vive en la base, así que no hay nada que firmar ni que
# rotar. Para revocar accesos de verdad se cierran las sesiones desde Admin —
# eso borra las filas y surte efecto en el momento.
#
# Duración de sesión en horas: deslizante y tope absoluto.
SESSION_SLIDING_HOURS="12"
SESSION_ABSOLUTE_HOURS="168"

# ───────────────────────── Primer administrador ─────────────────────────
# Solo se usa la PRIMERA vez que corre el seed. Después se ignora: el seed
# NUNCA rota una contraseña ya puesta.
#
# La contraseña inicial pasa por la MISMA política que se exige después, así que
# no puede tener menos de 12 caracteres ni contener "katana", "cotizador",
# "password", "contrasena", "123456", "qwerty", ni tu nombre o tu correo. Si no
# cumple, el contenedor no arranca y dice exactamente por qué.
#
# Sólo sirve para el primer acceso: el sistema obliga a cambiarla al entrar.
SEED_ADMIN_EMAIL="chuygallardo@katanatalent.com"
SEED_ADMIN_NOMBRE="Chuy Gallardo"
SEED_ADMIN_PASSWORD="CAMBIAR-esta-frase-larga-de-inicio"

# ────────────────────────── Almacenamiento ──────────────────────────
# Volumen persistente para PDFs emitidos y los .xlsx importados.
STORAGE_DIR="/var/lib/katana"

# ─────────────────────────── Generación de PDF ───────────────────────────
# En la imagen Docker, Playwright instala su propio Chromium y esta variable
# queda vacía. En desarrollo local apunta al binario ya presente:
#   /opt/pw-browsers/chromium-1194/chrome-linux/chrome
CHROMIUM_EXECUTABLE_PATH=""
PDF_CONCURRENCY="2"
PDF_TIMEOUT_MS="30000"

# ────────────────────────── Cloudflare Tunnel ──────────────────────────
# Token del túnel: Cloudflare Zero Trust › Networks › Tunnels › tu túnel.
# Con esto NO hace falta abrir los puertos 80/443 del servidor.
CLOUDFLARE_TUNNEL_TOKEN="CAMBIAR_token_del_tunel"

# ──────────────────────────── Respaldos ────────────────────────────
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS="30"

# ────────────────────────────── Registro ──────────────────────────────
LOG_LEVEL="info"
