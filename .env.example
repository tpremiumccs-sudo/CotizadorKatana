# ═══════════════════════════════════════════════════════════════════════════
#  Cotizador Katana Talent — variables de entorno
#
#  Copia este archivo a `.env` y cambia TODOS los valores marcados con CAMBIAR.
#  Genera los secretos con:  openssl rand -base64 48
#
#  TODOS los valores van entrecomillados: `docker compose` y `set -a; . .env`
#  interpretan de forma distinta los caracteres # $ y los espacios.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Base de datos ───────────────────────────
POSTGRES_USER="katana"
POSTGRES_PASSWORD="CAMBIAR_password_de_postgres"
POSTGRES_DB="katana"

# Dentro de Docker el host es el nombre del servicio (`db`).
# Para correr la app fuera de Docker contra la base de Docker usa localhost:5433.
DATABASE_URL="postgresql://katana:CAMBIAR_password_de_postgres@db:5432/katana?schema=public&connection_limit=10"

# ──────────────────────────── Aplicación ────────────────────────────
# NODE_ENV lo fija Next y Docker. NO lo pongas aquí: rompe `next build`.
APP_PUBLIC_URL="https://cotizador.katanatalent.com"
PORT="3000"

# sha256 de las cookies de sesión y de los tokens de invitación.
# openssl rand -base64 48
SESSION_SECRET="CAMBIAR_secreto_de_sesion_minimo_32_caracteres"

# Duración de sesión en horas: deslizante y tope absoluto.
SESSION_SLIDING_HOURS="12"
SESSION_ABSOLUTE_HOURS="168"

# ───────────────────────── Primer administrador ─────────────────────────
# Solo se usa la PRIMERA vez que corre el seed. Después se ignora.
# El usuario deberá cambiar la contraseña en su primer acceso.
SEED_ADMIN_EMAIL="chuygallardo@katanatalent.com"
SEED_ADMIN_NOMBRE="Chuy Gallardo"
SEED_ADMIN_PASSWORD="CAMBIAR_password_inicial_del_admin"

# ────────────────────────── Almacenamiento ──────────────────────────
# Volumen persistente para PDFs emitidos y los .xlsx importados.
STORAGE_DIR="/var/lib/katana"

# ─────────────────────────── Generación de PDF ───────────────────────────
# En la imagen Docker, Playwright instala su propio Chromium y esta variable
# queda vacía. En desarrollo local apunta al binario ya presente:
#   /opt/pw-browsers/chromium-1194/chrome-linux/chrome
CHROMIUM_EXECUTABLE_PATH=""
PDF_CONCURRENCY="2"
PDF_TIMEOUT_MS="30000"

# ────────────────────────── Cloudflare Tunnel ──────────────────────────
# Token del túnel: Cloudflare Zero Trust › Networks › Tunnels › tu túnel.
# Con esto NO hace falta abrir los puertos 80/443 del servidor.
CLOUDFLARE_TUNNEL_TOKEN="CAMBIAR_token_del_tunel"

# ──────────────────────────── Respaldos ────────────────────────────
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS="30"

# ────────────────────────────── Registro ──────────────────────────────
LOG_LEVEL="info"
